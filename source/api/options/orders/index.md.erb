async function getTransactionHistory() {
  try {
    // Initialize empty params object for optional filters
    const params = {};

    // Prompt for optional filters (empty input skips the filter)
    const startTs = prompt("Start timestamp (UNIX milliseconds):").trim();
    if (startTs) params.startTimestamp = startTs;

    const endTs = prompt("End timestamp (UNIX milliseconds):").trim();
    if (endTs) params.endTimestamp = endTs;

    const sortOrder = prompt("Sort order (asc/desc, default: desc):").trim().toLowerCase();
    if (sortOrder === 'asc' || sortOrder === 'desc') params.sortOrder = sortOrder;

    const pageSize = prompt("Page size:").trim();
    if (pageSize) params.pageSize = pageSize;

    const symbol = prompt("Symbol (e.g., BTC-4OCT25-120000-C-USDT):").trim();
    if (symbol) params.symbol = symbol;

    const idParam = prompt("ID for pagination:").trim();
    if (idParam) params.id = idParam;

    // Generate timestamp after collecting inputs
    const timestamp = Date.now().toString();

    // Clone params and add timestamp for signature generation
    const paramsWithTimestamp = { ...params, timestamp };

    // Build sorted query string for signature
    const queryStringForSignature = Object.keys(paramsWithTimestamp)
      .sort()
      .map(key => `${encodeURIComponent(key)}=${encodeURIComponent(paramsWithTimestamp[key])}`)
      .join('&');

    // Generate signature using a pre-defined generateSignature function
    const signature = generateSignature(api_secret, queryStringForSignature);

    // Construct query string for URL without timestamp sorted by insertion order
    const queryStringForUrl = Object.entries(params)
      .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`)
      .join('&');

    // Build final URL with mandatory timestamp and optional filters
    const transactionUrl = queryStringForUrl
      ? `${baseUrl}/v1/user-data/transaction-history?timestamp=${encodeURIComponent(timestamp)}&${queryStringForUrl}`
      : `${baseUrl}/v1/user-data/transaction-history?timestamp=${encodeURIComponent(timestamp)}`;

    // Setup headers with API key and signature
    const headers = {
      'Content-Type': 'application/json',
      'api-key': api_key,
      'signature': signature
    };

    // Send authenticated GET request
    const response = await fetch(transactionUrl, { method: 'GET', headers });

    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status} - ${response.statusText}`);
    }

    // Parse and return JSON response
    const responseData = await response.json();
    console.log('Transaction history fetched successfully:', JSON.stringify(responseData, null, 4));
    return responseData;

  } catch (error) {
    console.error('An unexpected error occurred:', error.message);
    return null;
  }
}
