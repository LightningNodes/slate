      const quantity = parseFloat(quantityInput);
      if (isNaN(quantity)) {
        console.log("Invalid quantity format.");
        return null;
      }
      payload.quantity = quantity;
    }

    // Optional fields: new price
    const priceInput = prompt("Enter new price (press Enter to skip):").trim();
    if (priceInput) {
      const price = parseInt(priceInput, 10);
      if (isNaN(price)) {
        console.log("Invalid price format.");
        return null;
      }
      payload.price = price;
    }

    // Optional fields: new order IV
    const orderIvInput = prompt("Enter new order IV (press Enter to skip):").trim();
    if (orderIvInput) {
