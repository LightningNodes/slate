        # Generate signature
        signature = generate_signature(api_secret, query_string)

        # Construct the URL with query parameters
        wallet_url = f"{base_url}/v1/wallet/options-wallet/details?{query_string}"

        # Set up headers with API key and signature
        headers = {
            'Content-Type': 'application/json',
            'api-key': api_key,
            'signature': signature
        }

        # Send the authenticated GET request
        response = requests.get(wallet_url, headers=headers)
