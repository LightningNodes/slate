async function getOptionsWalletDetails() {
  try {
    // Prompt if user wants to specify margin asset
    const includeMarginAsset = prompt("Do you want to specify a margin asset? (y/n):").toLowerCase();

    // Generate timestamp in milliseconds
    const timestamp = Date.now().toString();

    // Construct params object
    const params = { timestamp };

    if (includeMarginAsset === 'y') {
      const marginAsset = prompt("Enter the margin asset (e.g., USDT):").toUpperCase();
      params.marginAsset = marginAsset;
    }

    // Build query string from params
    const queryString = Object.entries(params)
      .map(([key, value]) => `${encodeURIComponent(key)}=${encodeURIComponent(value)}`)
      .join('&');

    // Generate signature using a provided generateSignature function
    // The function should accept api_secret and query string
    const signature = generateSignature(api_secret, queryString);

    // Construct URL
    const walletUrl = `${baseUrl}/v1/wallet/options-wallet/details?${queryString}`;

    // Set up headers with API key and signature
    const headers = {
      'Content-Type': 'application/json',
      'api-key': api_key,
      'signature': signature
    };

    // Send GET request
    const response = await fetch(walletUrl, { method: 'GET', headers });

    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status} - ${response.statusText}`);
    }

    // Parse and return JSON response
    const responseData = await response.json();
    console.log('Options wallet details fetched successfully:', JSON.stringify(responseData, null, 4));
    return responseData;

  } catch (error) {
    console.error('An unexpected error occurred:', error.message);
    return null;
  }
}
