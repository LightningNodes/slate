async function placeOrder() {
  try {
    // Select place type
    console.log("\nSelect place type:");
    console.log("1. ORDER_FORM");
    console.log("2. POSITION");
    const placeTypeChoice = prompt("Enter choice (1 or 2):").trim();

    let placeType;
    if (placeTypeChoice === "1") {
      placeType = "ORDER_FORM";
    } else if (placeTypeChoice === "2") {
      placeType = "POSITION";
    } else {
      console.log("Invalid choice. Operation cancelled.");
      return null;
    }

    // Required fields
    const symbol = prompt("Enter symbol (e.g., BTC-4OCT25-126000-C-USDT):").trim();
    if (!symbol) {
      console.log("Symbol is required. Operation cancelled.");
      return null;
    }

    // Select order type
    console.log("\nSelect order type:");
    console.log("1. MARKET");
    console.log("2. LIMIT");
    const orderTypeChoice = prompt("Enter choice (1 or 2):").trim();

    let orderType;
    if (orderTypeChoice === "1") {
      orderType = "MARKET";
    } else if (orderTypeChoice === "2") {
      orderType = "LIMIT";
    } else {
      console.log("Invalid choice. Operation cancelled.");
      return null;
    }

    // Build the payload
    const payload = {
      placeType,
      symbol,
      type: orderType
    };

    // POSITION place type requires quantity and positionId
    if (placeType === "POSITION") {
      const quantityInput = prompt("Enter quantity:").trim();
      const quantity = parseFloat(quantityInput);
      if (isNaN(quantity)) {
        console.log("Invalid quantity. Operation cancelled.");
        return null;
      }
      payload.quantity = quantity;

      const positionId = prompt("Enter position ID:").trim();
      if (!positionId) {
        console.log("Position ID is required for POSITION place type. Operation cancelled.");
        return null;
      }
      payload.positionId = positionId;
    }

    // ORDER_FORM place type requires quantity and side
    if (placeType === "ORDER_FORM") {
      const quantityInput = prompt("Enter quantity:").trim();
      const quantity = parseFloat(quantityInput);
      if (isNaN(quantity)) {
        console.log("Invalid quantity. Operation cancelled.");
        return null;
      }
      payload.quantity = quantity;

      console.log("\nSelect side:");
      console.log("1. BUY");
      console.log("2. SELL");
      const sideChoice = prompt("Enter choice (1 or 2):").trim();
      if (sideChoice === "1") {
        payload.side = "BUY";
      } else if (sideChoice === "2") {
        payload.side = "SELL";
      } else {
        console.log("Invalid choice. Operation cancelled.");
        return null;
      }
    }

    // Price is required for LIMIT order type
    if (orderType === "LIMIT") {
      const priceInput = prompt("Enter price:").trim();
      const price = parseInt(priceInput, 10);
      if (isNaN(price)) {
        console.log("Invalid price. Operation cancelled.");
        return null;
      }
      payload.price = price;
    }

    // Optional reference ID
    const refId = prompt("Enter reference ID (optional, press Enter to skip):").trim();
    if (refId) payload.refId = refId;

    // Add timestamp
    payload.timestamp = Date.now().toString();

    // Create data string for signature
    const dataToSign = JSON.stringify(payload);

    // Generate signature (implement generateSignature using your API secret)
    const signature = generateSignature(api_secret, dataToSign);

    // Setup headers with API key and signature
    const headers = {
      'Content-Type': 'application/json',
      'api-key': api_key,
      'signature': signature
    };

    // Endpoint URL
    const orderUrl = `${baseUrl}/v1/order/place-order`;

    // Send the authenticated POST request
    const response = await fetch(orderUrl, {
      method: 'POST',
      headers,
      body: JSON.stringify(payload)
    });

    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status} - ${response.statusText}`);
    }

    // Parse and return JSON response
    const responseData = await response.json();
    console.log('Order placed successfully:', JSON.stringify(responseData, null, 4));
    return responseData;

  } catch (error) {
    console.error('An unexpected error occurred:', error.message);
    return null;
  }
}
