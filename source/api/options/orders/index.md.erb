    """
    try:
        # Get user inputs
        from_wallet = input("Enter source wallet (FUNDING, FUTURES, or OPTIONS): ").upper()
        if from_wallet not in ["FUNDING", "FUTURES", "OPTIONS"]:
            print("Invalid source wallet. Must be one of: FUNDING, FUTURES, OPTIONS")
            return None

        to_wallet = input("Enter destination wallet (FUNDING, FUTURES, or OPTIONS): ").upper()
        if to_wallet not in ["FUNDING", "FUTURES", "OPTIONS"]:
            print("Invalid destination wallet. Must be one of: FUNDING, FUTURES, OPTIONS")
            return None

        try:
            amount = int(input("Enter amount to transfer: "))
            if amount <= 0:
                print("Amount must be greater than 0")
                return None
        except ValueError:
            print("Invalid amount. Please enter a valid number.")
            return None

        # Generate timestamp for the request
