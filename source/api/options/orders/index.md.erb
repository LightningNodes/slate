    if (!["FUNDING", "FUTURES", "OPTIONS"].includes(fromWallet)) {
      console.log("Invalid source wallet. Must be one of: FUNDING, FUTURES, OPTIONS");
      return null;
    }

    const toWallet = prompt("Enter destination wallet (FUNDING, FUTURES, or OPTIONS):").toUpperCase();
    if (!["FUNDING", "FUTURES", "OPTIONS"].includes(toWallet)) {
      console.log("Invalid destination wallet. Must be one of: FUNDING, FUTURES, OPTIONS");
      return null;
    }

    const amountInput = prompt("Enter amount to transfer:");
    const amount = Number(amountInput);
    if (isNaN(amount) || amount <= 0) {
      console.log("Invalid amount. Please enter a valid number greater than 0.");
      return null;
    }

    // Generate current timestamp in milliseconds
    const timestamp = Date.now().toString();

    // Create parameters object
    const params = {
      timestamp,
      from: fromWallet,
      to: toWallet,
      amount
    };

    // Generate signature using a provided generateSignature function
    // The generateSignature function should be defined to use api_secret and JSON string of params
    const dataToSign = JSON.stringify(params);
    const signature = generateSignature(api_secret, dataToSign);

    // Setup headers including API key and signature
    const headers = {
      'Content-Type': 'application/json',
      'api-key': api_key,
      'signature': signature
    };

    // URL for transfer
    const transferUrl = `${baseUrl}/v1/wallet/transfer-balance`;

    // Send POST request
    const response = await fetch(transferUrl, {
      method: 'POST',
      headers: headers,
      body: JSON.stringify(params)
    });

    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status} - ${response.statusText}`);
    }

    // Parse and return JSON response
    const responseData = await response.json();
    console.log('Balance transferred successfully:', JSON.stringify(responseData, null, 4));
    return responseData;

  } catch (error) {
    console.error('An unexpected error occurred:', error.message);
    return null;
  }
}
