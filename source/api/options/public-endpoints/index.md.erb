<h3 id='options-instrument-info-symbols'>Instrument Info Symbols</h3>
```javascript
async function getInstrumentInfoBySymbols() {
  try {
    // Prompt user to enter symbols one by one
    console.log("Enter symbols one by one (e.g., BTC-27MAR26-50000-C-USDT)");
    console.log("Press Enter on an empty line when done");
    const symbols = [];
    while (true) {
      const symbol = prompt("Enter symbol (or press Enter to finish):").trim();
      if (!symbol) break;
      symbols.push(symbol);
    }
    if (symbols.length === 0) {
      console.log("No symbols provided. Operation cancelled.");
      return null;
    }
    // Prepare payload
    const payload = { symbols };
    // Construct URL
    const instrumentInfoUrl = `${baseUrl}/v1/exchange/instrument-info-symbol`;
    // Send POST request
    const response = await fetch(instrumentInfoUrl, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify(payload)
    });
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status} - ${response.statusText}`);
    }
    // Parse and return JSON response
    const responseData = await response.json();
    console.log('Instrument information fetched successfully:', JSON.stringify(responseData, null, 4));
    return responseData;
  } catch (error) {
      console.error('Error:', error.message);
  }
  return null;
}
```
```python
def get_instrument_info_by_symbols():
    """
    Fetches details of specific instruments by providing their symbols.

    Returns:
        The JSON response containing instrument information for the specified symbols
    """
    try:
        # Get user inputs for symbols
        print("Enter symbols one by one (e.g., BTC-27MAR26-50000-C-USDT)")
        print("Press Enter on an empty line when done")

        symbols = []
        while True:
            symbol = input("Enter symbol (or press Enter to finish): ").strip()
            if not symbol:
                break
            symbols.append(symbol)

        if not symbols:
            print("No symbols provided. Operation cancelled.")
            return None

        # Prepare the request body
        payload = {"symbols": symbols}

        # Construct the URL
        instrument_info_url = f"{base_url}/v1/exchange/instrument-info-symbol"

        # Headers for the POST request
        headers = {
            'Content-Type': 'application/json'
        }

        # Send the POST request to fetch instrument information
        response = requests.post(instrument_info_url, json=payload, headers=headers)
        response.raise_for_status()  # Raises an error for 4xx/5xx responses

        # Parse and return the JSON response
        response_data = response.json()
        print('Instrument information fetched successfully:', json.dumps(response_data, indent=4))
        return response_data
    except Exception as e:
        print(f"An unexpected error occurred: {str(e)}")

    return None
```
