<h3 id='options-instrument-info'>Instrument Info</h3>
```javascript
async function getInstrumentInfo() {
  try {
    // Get user inputs for base coin and quote coin
    const baseCoin = prompt("Enter the base coin (e.g., BTC):").toUpperCase();
    const quoteCoin = prompt("Enter the quote coin (e.g., USDT):").toUpperCase();
    // Ask if they want to specify delivery time (optional)
    const includeDeliveryTime = prompt("Do you want to specify a delivery time? (y/n):").toLowerCase();
    // Build the URL
    let instrumentInfoUrl = `${baseUrl}/v1/exchange/instrument-info?baseCoin=${baseCoin}&quoteCoin=${quoteCoin}`;
    if (includeDeliveryTime === 'y') {
      const deliveryTime = prompt("Enter the delivery time (timestamp in milliseconds, e.g., 1774598400000):");
      instrumentInfoUrl += `&deliveryTime=${deliveryTime}`;
    }
    // Headers for the GET request
    const headers = {
      'Content-Type': 'application/json'
    };
    // Send the GET request to fetch instrument information
    const response = await fetch(instrumentInfoUrl, { method: 'GET', headers });
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status} - ${response.statusText}`);
    }
    // Parse and return the JSON response
    const responseData = await response.json();
    console.log('Instrument information fetched successfully:', JSON.stringify(responseData, null, 4));
    return responseData;
  } catch (error) {
      console.error('Error:', error.message);
  }
  return null;
}
```
