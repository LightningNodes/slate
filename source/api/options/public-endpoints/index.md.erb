<h3 id='options-delivery-times'>Delivery Times</h3>
```javascript
async function getDeliveryTimes() {
  try {
    // Get user inputs for base and quote coins via prompt in browser
    const baseCoin = prompt("Enter the base coin (e.g., BTC):").toUpperCase();
    const quoteCoin = prompt("Enter the quote coin (e.g., USDT):").toUpperCase();
    // Construct the URL with query parameters
    const deliveryTimesUrl = `${baseUrl}/v1/exchange/delivery-times?baseCoin=${baseCoin}&quoteCoin=${quoteCoin}`;
    // Headers for the GET request
    const headers = {
      'Content-Type': 'application/json'
    };
    // Send the GET request to fetch delivery times
    const response = await fetch(deliveryTimesUrl, {
      method: 'GET',
      headers: headers
    });
    if (!response.ok) {
      throw new Error(`HTTP error! Status: ${response.status} - ${response.statusText}`);
    }
    // Parse and return the JSON response
    const responseData = await response.json();
    console.log('Delivery times fetched successfully:', JSON.stringify(responseData, null, 4));
    return responseData;
  } catch (error) {
      console.error('Error:', error.message);
  }
  return null;
}
```
